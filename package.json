{
  "name": "cc-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "build": "node scripts/run-workspaces.mjs build",
    "assistant:doctor": "node scripts/doctor.mjs",
    "controller": "node scripts/start-controller.mjs",
    "controller:bg": "node scripts/start-controller.mjs --background",
    "controller:bg:auto": "node scripts/start-controller.mjs --background --permission-mode auto",
    "controller:bg:bypass": "node scripts/start-controller.mjs --background --permission-mode bypassPermissions",
    "controller:sandbox": "node scripts/start-controller.mjs --sandbox",
    "cca": "node apps/cli/dist/index.js",
    "dev": "node scripts/run-workspaces.mjs dev",
    "dev:daemon": "node scripts/run-workspaces.mjs dev:daemon",
    "dev:web": "node scripts/run-workspaces.mjs dev:web",
    "start": "node scripts/runtime-recipe.mjs start default",
    "startup": "bash ./start.sh",
    "start:daemon": "node scripts/run-workspaces.mjs start",
    "recipe": "node scripts/runtime-recipe.mjs",
    "recipe:list": "node scripts/runtime-recipe.mjs list",
    "recipe:status": "node scripts/runtime-recipe.mjs status",
    "smoke:mcp": "node scripts/mcp-smoke.mjs",
    "smoke:browser:e2e": "node scripts/browser-live-e2e.mjs",
    "native:watch-notifications": "swift native/macos/notification-watcher.swift --daemon http://127.0.0.1:4317 --token-file .data/access-token",
    "macos:services:install": "node scripts/install-macos-services.mjs",
    "macos:services:remove": "node scripts/install-macos-services.mjs --remove",
    "macos:services:dry-run": "node scripts/install-macos-services.mjs --dry-run",
    "plugin:build": "node scripts/sync-controller-prompt.mjs && esbuild apps/mcp/src/index.ts --bundle --platform=node --format=esm --outfile=claude-plugin/server/index.mjs",
    "plugin:validate": "claude plugin validate ./claude-plugin --strict",
    "hooks:install-global": "node scripts/install-global-claude-hooks.mjs",
    "hooks:remove-global": "node scripts/install-global-claude-hooks.mjs --remove",
    "test": "node scripts/run-workspaces.mjs test",
    "typecheck": "node scripts/run-workspaces.mjs typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0",
    "vitest": "^5.0.1"
  }
}
