{
  "name": "cc-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "build": "pnpm -r build",
    "assistant:doctor": "node scripts/doctor.mjs",
    "cca": "node apps/cli/dist/index.js",
    "dev": "pnpm --parallel --filter @cc-assistant/daemon --filter @cc-assistant/web dev",
    "dev:daemon": "pnpm --filter @cc-assistant/daemon dev",
    "dev:web": "pnpm --filter @cc-assistant/web dev",
    "start": "pnpm --filter @cc-assistant/daemon start",
    "smoke:mcp": "node scripts/mcp-smoke.mjs",
    "smoke:browser:e2e": "node scripts/browser-live-e2e.mjs",
    "native:watch-notifications": "swift native/macos/notification-watcher.swift --daemon http://127.0.0.1:4317 --token-file .data/access-token",
    "macos:services:install": "node scripts/install-macos-services.mjs",
    "macos:services:remove": "node scripts/install-macos-services.mjs --remove",
    "macos:services:dry-run": "node scripts/install-macos-services.mjs --dry-run",
    "plugin:build": "esbuild apps/mcp/src/index.ts --bundle --platform=node --format=esm --outfile=claude-plugin/server/index.mjs",
    "plugin:validate": "claude plugin validate ./claude-plugin --strict",
    "hooks:install-global": "node scripts/install-global-claude-hooks.mjs",
    "hooks:remove-global": "node scripts/install-global-claude-hooks.mjs --remove",
    "test": "pnpm --filter @cc-assistant/shared build && pnpm --filter @cc-assistant/client build && pnpm -r test",
    "typecheck": "pnpm --filter @cc-assistant/shared build && pnpm --filter @cc-assistant/client build && pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0",
    "vitest": "^5.0.1"
  }
}
