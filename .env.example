# The default development paths already work when commands are run through pnpm.
CC_ASSISTANT_DATA_DIR=.data
CC_ASSISTANT_HOST=127.0.0.1
CC_ASSISTANT_PORT=4317
CC_ASSISTANT_DAEMON_URL=http://127.0.0.1:4317
# Path-delimited roots in which commands and managed agents may run.
# CC_ASSISTANT_ALLOWED_ROOTS=/path/to/work:/another/workspace

# Browser jobs use Claude Code's built-in Claude-in-Chrome integration.
CC_ASSISTANT_BROWSER_ENABLED=true
# Prefer the signed-in Claude Code subscription over an inherited API key.
CC_ASSISTANT_BROWSER_USE_CLAUDE_LOGIN=true
CC_ASSISTANT_BROWSER_MODEL=sonnet
CC_ASSISTANT_BROWSER_EFFORT=low
CC_ASSISTANT_BROWSER_MAX_TURNS=12
CC_ASSISTANT_BROWSER_MAX_BUDGET_USD=1.00

# Normally generated into CC_ASSISTANT_DATA_DIR/access-token on first start.
# CC_ASSISTANT_TOKEN=

# Prefer the signed-in Claude Code subscription for managed agent runs.
CC_ASSISTANT_AGENT_USE_CLAUDE_LOGIN=true
